#!/usr/bin/env python3
"""minime-fetch —— 从腾讯官方地址下载 MinIME 需要的官方文件，校验后解包到本机。

MinIME 的仓库和软件包都不包含腾讯的文件；每个用户用这个工具把它们下载到自己的数据目录：

  engine  Windows 安装包里的引擎和词库（约 218 MB 下载，解包后约 270 MB）     必需
  e2e     macOS 安装包里的整句模型（只用 HTTP Range 取 3 个文件，约 78 MB）   推荐
  voice   官方离线语音模型包（输入法按需下载的资源包，约 103 MB；交给 minime-asrd fetch-model） 可选

用法:
  minime-fetch                 下载引擎和整句模型（已有的跳过）
  minime-fetch all             再加上语音模型
  minime-fetch engine|e2e|voice ...
  minime-fetch status          看看装了哪些
  minime-fetch setup           只做下载后的配置：启用并重启引擎服务、把 MinIME 加进 fcitx5 的输入法列表
  minime-fetch engine --from WeTypeSetup_3.0.1.35_3.exe   用已经下载好的安装包
  minime-fetch ... --json      每行输出一个 JSON 事件（给设置程序显示进度用）：
                               {"ev":"stage","item":"engine|e2e|voice|setup","stage":"download|verify|extract|run|done|skip"}
                               {"ev":"progress","item":…,"done":字节,"total":字节,"speed":字节每秒}
                               {"ev":"log","msg":…}  {"ev":"error","msg":…}  {"ev":"done","ok":true}

下载完成后会自动做 setup 那一步（加 --no-setup 跳过）。

文件放在 $XDG_DATA_HOME/minime/official/（缺省 ~/.local/share/minime/official/）。只依赖 python3 和 7z。
"""
import hashlib
import io
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
import zipfile
import zlib

UA = {"User-Agent": "Mozilla/5.0"}
CHUNK = 1 << 20

WIN_VERSION = "3.0.1.35"
WIN_NAME = "WeTypeSetup_%s_3.exe" % WIN_VERSION
WIN_URL = "https://download.z.weixin.qq.com/app/win/" + WIN_NAME
WIN_SHA256 = "012954b4de350621ec846c3200bcbc48f4df4014c381b70fcd7e4864b0a01846"
# 引擎实际装载的 DLL（libwxhld.dll 的导入，递归到同目录）和内置词库
WIN_FILES = ["libwxhld.dll", "XNet.dll", "tensorflowlite_c.dll", "dbghelp.dll", "ime_net.dll", "wcwss.dll"]

MAC_URL = "https://download.weread.qq.com/app/wxkb/mac/3.0.1/WeType_3.0.1_684.zip"
MAC_DIR = "WeType.app/Contents/Resources/imeData.bundle/"
MAC_FILES = {
    "index.json": "d723c9014bf05a9e7ffd370a90e5785c",
    "mpd_e2e.bin": "79484c59df2f9887be0f8688e79d0363",
    "decgnr.bin": "f02c2ce40f5a7f19f2c05419f2a613eb",
}


def data_home():
    return os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")


OFFICIAL = os.path.join(data_home(), "minime", "official")
ENGINE_DIR = os.path.join(OFFICIAL, "win", WIN_VERSION)
E2E_DIR = os.path.join(OFFICIAL, "mac", "imeData")


JSON = False          # --json：给设置程序读的事件流
CUR = ""              # 当前在处理的项（engine / e2e / voice / setup），进度事件带上它


def emit(**ev):
    print(json.dumps(ev, ensure_ascii=False), flush=True)


def stage(item, st):
    global CUR
    CUR = item
    if JSON:
        emit(ev="stage", item=item, stage=st)


def say(msg):
    if JSON:
        emit(ev="log", item=CUR, msg=msg.strip())
    else:
        print(msg, flush=True)


def die(msg):
    if JSON:
        emit(ev="error", item=CUR, msg=msg)
    else:
        print("minime-fetch: " + msg, file=sys.stderr)
    sys.exit(1)


def file_hash(path, algo):
    h = hashlib.new(algo)
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(CHUNK), b""):
            h.update(block)
    return h.hexdigest()


class Progress:
    """下载进度：终端里原地刷新一行（MB、百分比、速度），不是终端时每 16 MB 打一行。"""

    def __init__(self, total):
        self.total, self.done, self.t0, self.last = total, 0, time.time(), 0
        self.tty = sys.stdout.isatty() and not JSON
        self.last_t = 0.0

    def add(self, n):
        self.done += n
        if JSON:
            if time.time() - self.last_t >= 0.2:
                self.last_t = time.time()
                self.show()
        elif self.tty or self.done - self.last >= 16 * CHUNK:
            self.last = self.done
            self.show()

    def show(self, end=False):
        if JSON:
            emit(ev="progress", item=CUR, done=self.done, total=self.total,
                 speed=int(self.done / max(time.time() - self.t0, 0.001)))
            return
        speed = self.done / max(time.time() - self.t0, 0.001) / (1 << 20)
        pct = " %3d%%" % (self.done * 100 // self.total) if self.total else ""
        line = "  %6.1f / %.1f MB%s  %.1f MB/s" % (self.done / (1 << 20), self.total / (1 << 20), pct, speed)
        if self.tty:
            sys.stdout.write("\r" + line + ("\n" if end else ""))
            sys.stdout.flush()
        elif end or self.done - self.last == 0:
            print(line, flush=True)

    def finish(self):
        self.show(end=True)


def download(url, dest):
    part = dest + ".part"
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=60) as resp, open(part, "wb") as out:
        bar = Progress(int(resp.headers.get("Content-Length") or 0))
        while True:
            block = resp.read(CHUNK)
            if not block:
                break
            out.write(block)
            bar.add(len(block))
        bar.finish()
    os.replace(part, dest)


# ---------------- 引擎（Windows 安装包） ----------------

def engine_ok():
    return os.path.isfile(os.path.join(ENGINE_DIR, "libwxhld.dll")) and \
        os.path.isfile(os.path.join(ENGINE_DIR, "BuildIn", "index.json"))


def fetch_engine(src=None, force=False):
    stage("engine", "download")
    if engine_ok() and not force:
        stage("engine", "skip")
        say("引擎：已安装（%s）" % ENGINE_DIR)
        return
    seven = shutil.which("7z") or shutil.which("7zz") or die("需要 7z（Arch: p7zip，Debian/Ubuntu: 7zip 或 p7zip-full，Fedora: p7zip-plugins）")
    os.makedirs(OFFICIAL, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="fetch-", dir=OFFICIAL) as tmp:
        exe = src
        if not exe:
            exe = os.path.join(tmp, WIN_NAME)
            say("下载 Windows 安装包（约 218 MB）：%s" % WIN_URL)
            download(WIN_URL, exe)
        stage("engine", "verify")
        got = file_hash(exe, "sha256")
        if got != WIN_SHA256:
            die("安装包 SHA-256 不对：%s（应为 %s）" % (got, WIN_SHA256))
        stage("engine", "extract")
        say("校验通过，解包引擎和词库")
        out = os.path.join(tmp, "x")
        pats = ["-i!%s/%s" % (WIN_VERSION, f) for f in WIN_FILES] + ["-i!%s/BuildIn/*" % WIN_VERSION]
        subprocess.run([seven, "x", "-y", "-o" + out] + pats + [exe], check=True, stdout=subprocess.DEVNULL)
        got_dir = os.path.join(out, WIN_VERSION)
        if not os.path.isfile(os.path.join(got_dir, "libwxhld.dll")):
            die("解包后没有找到 libwxhld.dll")
        if os.path.isdir(ENGINE_DIR):
            shutil.rmtree(ENGINE_DIR)
        os.makedirs(os.path.dirname(ENGINE_DIR), exist_ok=True)
        os.replace(got_dir, ENGINE_DIR)
    say("引擎：已安装到 %s" % ENGINE_DIR)
    stage("engine", "done")


# ---------------- 整句模型（macOS 安装包，只取 3 个文件） ----------------

class RangeFile(io.RawIOBase):
    """用 HTTP Range 请求按需读远程文件，配合 zipfile 只取需要的成员。"""

    def __init__(self, url):
        self.url, self.pos = url, 0
        req = urllib.request.Request(url, method="HEAD", headers=UA)
        self.size = int(urllib.request.urlopen(req, timeout=60).headers["Content-Length"])

    def seekable(self):
        return True

    def readable(self):
        return True

    def tell(self):
        return self.pos

    def seek(self, off, whence=0):
        self.pos = off if whence == 0 else self.pos + off if whence == 1 else self.size + off
        return self.pos

    def readinto(self, buf):
        n = min(len(buf), self.size - self.pos)
        if n <= 0:
            return 0
        hdr = dict(UA, Range="bytes=%d-%d" % (self.pos, self.pos + n - 1))
        data = urllib.request.urlopen(urllib.request.Request(self.url, headers=hdr), timeout=120).read()
        buf[:len(data)] = data
        self.pos += len(data)
        return len(data)


def e2e_ok():
    return all(os.path.isfile(os.path.join(E2E_DIR, f)) for f in MAC_FILES)


def fetch_member(url, info, dest, bar):
    """一个 zip 成员：读本地文件头算出数据的位置，一次 Range 请求流式下载压缩数据，边下边解压。"""
    hdr = dict(UA, Range="bytes=%d-%d" % (info.header_offset, info.header_offset + 29))
    lh = urllib.request.urlopen(urllib.request.Request(url, headers=hdr), timeout=60).read()
    if lh[:4] != b"PK\x03\x04":
        die("zip 本地文件头不对：%s" % info.filename)
    start = info.header_offset + 30 + int.from_bytes(lh[26:28], "little") + int.from_bytes(lh[28:30], "little")
    end = start + info.compress_size - 1
    if info.compress_type == zipfile.ZIP_DEFLATED:
        dec = zlib.decompressobj(-15)
    elif info.compress_type == zipfile.ZIP_STORED:
        dec = None
    else:
        die("不支持的压缩方式 %d：%s" % (info.compress_type, info.filename))
    crc = 0
    req = urllib.request.Request(url, headers=dict(UA, Range="bytes=%d-%d" % (start, end)))
    with urllib.request.urlopen(req, timeout=120) as resp, open(dest, "wb") as out:
        while True:
            block = resp.read(CHUNK)
            if not block:
                break
            bar.add(len(block))
            data = dec.decompress(block) if dec else block
            crc = zlib.crc32(data, crc)
            out.write(data)
        if dec:
            tail = dec.flush()
            crc = zlib.crc32(tail, crc)
            out.write(tail)
    if crc != info.CRC:
        die("%s 的 CRC 不对" % info.filename)


def fetch_e2e(force=False):
    stage("e2e", "download")
    if e2e_ok() and not force:
        stage("e2e", "skip")
        say("整句模型：已安装（%s）" % E2E_DIR)
        return
    say("从 macOS 安装包取整句模型（约 78 MB）：%s" % MAC_URL)
    z = zipfile.ZipFile(io.BufferedReader(RangeFile(MAC_URL), 1 << 20))   # 只读目录
    os.makedirs(E2E_DIR, exist_ok=True)
    infos = {name: z.getinfo(MAC_DIR + name) for name in MAC_FILES}
    bar = Progress(sum(i.compress_size for i in infos.values()))      # 三个文件合成一条进度
    for name, md5 in MAC_FILES.items():
        dest = os.path.join(E2E_DIR, name)
        part = dest + ".part"
        if not JSON:
            say("  %s" % name)
        fetch_member(MAC_URL, infos[name], part, bar)
        got = file_hash(part, "md5")
        if got != md5:
            os.unlink(part)
            die("%s 的 MD5 不对：%s（应为 %s）" % (name, got, md5))
        os.replace(part, dest)
    bar.finish()
    say("整句模型：已安装到 %s" % E2E_DIR)
    stage("e2e", "done")


# ---------------- 语音模型（交给 minime-asrd） ----------------

def asrd_bin():
    here = os.path.dirname(os.path.abspath(__file__))
    for p in (shutil.which("minime-asrd"), os.path.join(here, "..", "asrd", "target", "release", "minime-asrd")):
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def voice_ok():
    d = os.path.join(data_home(), "minime", "asr", "model")
    return os.path.isdir(d) and any(f.endswith(".xnet") for f in os.listdir(d))


def fetch_voice(force=False):
    stage("voice", "download")
    model_dir = os.path.join(data_home(), "minime", "asr", "model")
    if voice_ok() and not force:
        stage("voice", "skip")
        say("语音模型：已安装")
        return
    if force and os.path.isdir(model_dir):
        shutil.rmtree(model_dir, ignore_errors=True)
    b = asrd_bin() or die("没有找到 minime-asrd（离线语音组件没有安装）")
    say("下载语音模型（约 100 MB）")
    if not JSON:
        subprocess.run([b, "fetch-model"], check=True)
        return
    # JSON：minime-asrd 用 curl 下到 asr/ime_asr_decoder_model.apk，先报总大小；这里按文件长度报进度
    apk = os.path.join(data_home(), "minime", "asr", "ime_asr_decoder_model.apk")
    env = dict(os.environ, MINIME_FETCH_JSON="1")
    p = subprocess.Popen([b, "fetch-model"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
    import threading
    total = [0]

    def reader():
        for line in p.stdout:
            line = line.strip()
            if line.startswith("{"):
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                if ev.get("ev") == "total":
                    total[0] = int(ev.get("bytes") or 0)
                elif ev.get("ev") == "verify":
                    stage("voice", "verify")
                elif ev.get("ev") == "extract":
                    stage("voice", "extract")
            elif line:
                say(line)
    t = threading.Thread(target=reader, daemon=True)
    t.start()
    bar = None
    while p.poll() is None:
        time.sleep(0.25)
        if total[0]:
            try:
                sz = os.path.getsize(apk)
            except OSError:
                continue
            if bar is None:
                bar = Progress(total[0])
            bar.add(sz - bar.done)
    t.join(2)
    if p.returncode != 0:
        die("语音模型下载失败")
    if bar:
        bar.finish()
    stage("voice", "done")


# ---------------- 装好之后：启动引擎服务、把 MinIME 加进 fcitx5 ----------------

def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None


def setup_service():
    """启用并（重新）启动引擎服务：新下载的模型只在引擎启动时加载。"""
    if not shutil.which("systemctl"):
        say("提示：没有 systemctl，请自己启动 minime-engined")
        return
    if (r := run(["systemctl", "--user", "cat", "minime-engined"])) is None or r.returncode != 0:
        say("提示：没有找到 minime-engined 用户服务（MinIME 的软件包装好了吗？）")
        return
    run(["systemctl", "--user", "enable", "minime-engined"])
    r = run(["systemctl", "--user", "restart", "minime-engined"])
    if r is not None and r.returncode == 0:
        say("引擎服务：已启用并启动（minime-engined）")
    else:
        say("提示：引擎服务没能启动，查看 journalctl --user -u minime-engined")


def fcitx(*args):
    """调 fcitx5 的 D-Bus 控制接口，返回结果列表；fcitx5 没在运行时返回 None。"""
    r = run(["busctl", "--user", "--json=short", "call", "org.fcitx.Fcitx5", "/controller",
             "org.fcitx.Fcitx.Controller1", *args])
    if r is None or r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)["data"] if r.stdout.strip() else []
    except ValueError:
        return None


def setup_fcitx5():
    """把 MinIME 加进 fcitx5 当前的输入法分组（已经在了就不动）。"""
    if not shutil.which("busctl") or fcitx("CurrentInputMethodGroup") is None:
        say("提示：fcitx5 没有在运行。启用 fcitx5 后，在 fcitx5 配置里添加「MinIME」，"
            "或者再运行一次 minime-fetch setup")
        return
    has = lambda: any(im[0] == "minime" for im in (fcitx("AvailableInputMethods") or [[]])[0])
    if not has():
        fcitx("Refresh")                       # 软件包是在 fcitx5 启动之后装的：重新扫描插件
        time.sleep(1)
    if not has():
        say("提示：fcitx5 还没有加载 MinIME 插件。重新登录（或重启 fcitx5）后再运行 minime-fetch setup")
        return
    group = fcitx("CurrentInputMethodGroup")[0]
    layout, items = fcitx("InputMethodGroupInfo", "s", group)
    if any(im == "minime" for im, _ in items):
        say("fcitx5：MinIME 已经在输入法列表里（Ctrl+Space 切换）")
        return
    items = items + [["minime", ""]]
    flat = [x for it in items for x in it]
    if fcitx("SetInputMethodGroupInfo", "ssa(ss)", group, layout, str(len(items)), *flat) is None:
        say("提示：没能把 MinIME 加进 fcitx5，请在 fcitx5 配置里手动添加")
        return
    fcitx("Save")
    say("fcitx5：已把 MinIME 加进输入法列表（Ctrl+Space 切换）")


def setup_voice():
    if shutil.which("systemctl") and (r := run(["systemctl", "--user", "enable", "--now", "minime-asrd.socket"])) \
            and r.returncode == 0:
        say("语音服务：已启用（按需启动，按住右 Alt 说话）")
    else:
        say("提示：语音服务没能启用，运行 systemctl --user enable --now minime-asrd.socket")


def setup(voice=False, engine=True):
    stage("setup", "run")
    if not engine_ok():
        say("引擎还没有下载，先运行 minime-fetch")
        return 1
    if engine:
        setup_service()
        setup_fcitx5()
    if voice:
        setup_voice()
    stage("setup", "done")
    return 0


def status():
    rows = [("引擎", engine_ok(), ENGINE_DIR, "必需"), ("整句模型", e2e_ok(), E2E_DIR, "推荐"),
            ("语音模型", voice_ok(), os.path.join(data_home(), "minime", "asr", "model"), "可选")]
    for name, ok, path, need in rows:
        say("%-6s %s  %s（%s）" % (name, "已安装" if ok else "未安装", path, need))
    return 0 if engine_ok() else 1


def main(argv):
    if any(a in ("-h", "--help", "help") for a in argv):
        print(__doc__)
        return 0
    global JSON
    JSON = "--json" in argv
    force = "--force" in argv
    src = None
    if "--from" in argv:
        i = argv.index("--from")
        src = argv[i + 1] if i + 1 < len(argv) else die("--from 后面要跟安装包路径")
        argv = argv[:i] + argv[i + 2:]
    no_setup = "--no-setup" in argv
    known_flags = {"-h", "--help", "--json", "--force", "--no-setup", "--from"}
    for a in argv:
        if a.startswith("-") and a not in known_flags:
            die("不认识的选项：%s（minime-fetch --help）" % a)
    what = [a for a in argv if not a.startswith("-")] or ["engine", "e2e"]
    if what == ["status"]:
        return status()
    if what == ["setup"]:
        return setup(voice=voice_ok(), engine=True)
    if "all" in what:
        what = ["engine", "e2e", "voice"]
    for w in what:
        if w == "engine":
            fetch_engine(src, force)
        elif w == "e2e":
            fetch_e2e(force)
        elif w == "voice":
            fetch_voice(force)
        else:
            die("不认识的参数：%s（minime-fetch --help）" % w)
    if no_setup:
        say("完成。")
        return 0
    if not engine_ok():
        if "voice" in what:
            setup_voice()
        say("完成。")
        return 0
    say("下载完成，接着配置：")
    return setup(voice="voice" in what, engine="engine" in what or "e2e" in what)


def run_main():
    try:
        rc = main(sys.argv[1:])
    except KeyboardInterrupt:
        sys.exit(130)
    except SystemExit:
        raise
    except Exception as e:                      # 网络断了、磁盘满了等：JSON 模式下也要告诉设置程序
        if JSON:
            emit(ev="error", item=CUR, msg="%s: %s" % (type(e).__name__, e))
            sys.exit(1)
        raise
    if JSON:
        emit(ev="done", ok=rc == 0)
    sys.exit(rc)


if __name__ == "__main__":
    run_main()
